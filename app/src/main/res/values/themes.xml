<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UniSchedule" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/glass_accent</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/glass_accent</item>
        <item name="colorSurface">@color/glass_surface_strong</item>
        <item name="colorOnSurface">@color/glass_text_primary</item>
        <item name="colorControlNormal">@color/glass_text_secondary</item>
        <item name="colorControlActivated">@color/glass_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/glass_backdrop_base</item>
        <item name="android:textColorPrimary">@color/glass_text_primary</item>
        <item name="android:textColorSecondary">@color/glass_text_secondary</item>
        <item name="materialCardViewStyle">@style/Widget.UniSchedule.CardView</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.UniSchedule.Button.Outlined</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.UniSchedule.Dialog</item>
    </style>

    <style name="Theme.UniSchedule.Splash" parent="Theme.UniSchedule">
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.UniSchedule.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/glass_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/glass_stroke_start</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.UniSchedule.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/glass_stroke_start</item>
        <item name="android:textColor">@color/glass_text_primary</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <style name="ThemeOverlay.UniSchedule.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/glass_surface_strong</item>
        <item name="colorOnSurface">@color/glass_text_primary</item>
        <item name="colorPrimary">@color/glass_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.UniSchedule.DatePicker" parent="android:Theme.DeviceDefault.Dialog.Alert" />

    <style name="TextAppearance.UniSchedule.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/glass_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.UniSchedule.ToolbarSubtitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/glass_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

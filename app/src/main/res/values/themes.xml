<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UniSchedule" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
    <style name="Theme.UniSchedule.Splash" parent="Theme.UniSchedule">
        <item name="android:windowBackground">@color/primary</item>
    </style>
    <!-- ✅ Добавьте этот стиль -->
    <style name="Widget.UniSchedule.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- ✅ И этот стиль -->
    <style name="Widget.UniSchedule.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
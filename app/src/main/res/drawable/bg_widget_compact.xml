<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Faux-Liquid Glass compact widget backdrop -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:startColor="#D9161E38"
                android:centerColor="#D91E2046"
                android:endColor="#D9102438"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle 135° internal specular sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:startColor="#28FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#10FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <!-- 1dp specular border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#52FFFFFF" />
        </shape>
    </item>
</layer-list>

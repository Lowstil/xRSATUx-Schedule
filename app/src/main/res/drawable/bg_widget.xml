<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Faux-Liquid Glass deep translucent backdrop for home screen widgets -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:centerColor="#E01D1B42"
                android:endColor="#E00F1F33"
                android:startColor="#E0141B33"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle 135° internal specular sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:centerColor="#00FFFFFF"
                android:endColor="#0CFFFFFF"
                android:startColor="#24FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <!-- 1dp specular border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>

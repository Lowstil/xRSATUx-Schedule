<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Градиент: голубой → фиолетовый — яркий акцент, который сразу бросается в глаза -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF667EEA"
                android:endColor="#FF764BA2"
                android:angle="135" />
        </shape>
    </item>
    <!-- Тонкая внутренняя светлая обводка для глубины -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#44FFFFFF" />
        </shape>
    </item>
</layer-list>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHwItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbHwDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHwSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/glass_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHwMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/glass_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvHwText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="@color/glass_text_primary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/ivHwPhotoThumb"
            android:layout_width="88dp"
            android:layout_height="62dp"
            android:layout_marginTop="8dp"
            android:contentDescription="Фото заметки"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnHwDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Удалить заметку"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        app:tint="@color/glass_danger" />
</LinearLayout>
